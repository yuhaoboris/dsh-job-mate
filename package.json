{
  "name": "@yuhaoboris/dsh-job-mate",
  "version": "2.3.0",
  "description": "职伴：DeepSeek Harness 求职工作台（BOSS 直聘筛选、跟进与沟通记录）",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "skills/",
    "vendor/job-mate/",
    "upstream-lock.json",
    "locale/*.json",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.5.438"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "check:upstream": "node scripts/sync-upstream.mjs --check",
    "prepack": "npm run check:upstream"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuhaoboris/dsh-job-mate.git"
  }
}
